# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# testing
/coverage

# browser tests (Playwright): reports and downloads are outputs, never committed
/playwright-report
/test-results
/e2e/.downloads

# misc
.DS_Store
*.pem
Thumbs.db

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — only .env.example is committed
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# typescript
*.tsbuildinfo

# editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# optional account server data (see docs/SERVER.md)
/.data/
