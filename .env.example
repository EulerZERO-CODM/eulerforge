# Euler's Forge — environment variables
#
# Copy to `.env.local` for local development:  cp .env.example .env.local
#
# Rules for this file:
#   1. Never add a variable that holds a secret. Phase 1 ships a browser-only application
#      with no server secrets, so only NEXT_PUBLIC_* values exist here.
#   2. Every variable below is validated by src/config/env.ts. An invalid value fails fast with
#      a readable error instead of silently falling back to a default.
#   3. Anything prefixed NEXT_PUBLIC_ is embedded in the client bundle. Never put
#      credentials, private URLs or tokens behind that prefix.

# Public origin the app is served from. Used for absolute URLs in metadata. Must be a valid
# absolute http(s) URL.
NEXT_PUBLIC_FORGE_SITE_URL=http://localhost:3000

# Asset catalogue source.
#   sample — bundled, clearly-labelled sample records (default)
#   empty  — start from an empty catalogue; exercises the catalogue empty state
# A remote catalogue adapter is planned (see docs/ROADMAP.md) but not implemented in Phase 1.
NEXT_PUBLIC_FORGE_CATALOG_SOURCE=sample

# Telemetry is off. The variable exists so that enabling a telemetry adapter later is an
# explicit, reviewable change rather than an accident. `on` is rejected by validation until
# a real adapter + privacy review exist.
NEXT_PUBLIC_FORGE_TELEMETRY=off

# Product environment label surfaced in the UI and in diagnostics. Purely informational.
NEXT_PUBLIC_FORGE_ENVIRONMENT=development

# ---------------------------------------------------------------------------------------------
# Optional account server (Phase 7)
# ---------------------------------------------------------------------------------------------
# Where the server keeps accounts, sessions, documents and share links when you use
# /api/auth/*, /api/documents and /api/account. It is a JSON file store for ONE process, not a
# deployment claim — see docs/SERVER.md and ADR-0027.
#
# This is the only server-side variable. There is deliberately no secret to set: passwords are
# user-chosen and hashed with scrypt, and session tokens are generated per sign-in. Do not put a
# password, token or API key in this file.
#
# Unset, it defaults to `.data/` beside the app (git-ignored). An absolute path is allowed.
# FORGE_DATA_DIR=./.data
